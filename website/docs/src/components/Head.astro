---
const route = Astro.locals.starlightRoute;
const isNotFound = route.entry.id === '404' || route.entry.id.endsWith('/404');
// The static error page has no localized /404/ routes. Keep its metadata
// from advertising nonexistent canonical and alternate pages.
const head = route.head.filter(({ tag, attrs }) => !isNotFound || !(
  (tag === 'link' && ['canonical', 'alternate'].includes(String(attrs?.rel))) ||
  (tag === 'meta' && attrs?.property === 'og:url')
));
---

{head.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}
