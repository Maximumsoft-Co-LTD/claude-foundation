---
/**
 * Starlight's default SiteTitle renders the configured `title` string next to a
 * logo image. The brand here is the Change Loop mark (an ink tile holding an
 * orange loop that closes on a check) plus a two-weight monospace wordmark. The
 * wordmark needs the page's webfont, which a standalone <img> SVG cannot load,
 * so the mark is inlined and the text stays live HTML.
 *
 * Keep the mark geometry in step with `public/favicon.svg` and the landing
 * page's `.brand-mark` in ../../../index.html.
 *
 * The mark links to the landing page rather than the docs index: the docs are a
 * section of the site, and the header logo is how a reader gets back out.
 */
const base = import.meta.env.BASE_URL.replace(/\/docs\/?$/, "/");
---

<a class="cf-brand" href={base} aria-label="Change Loop home">
  <svg class="cf-brand-mark" viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="14" fill="#17181c"></rect>
    <circle cx="32" cy="32" r="15" fill="none" stroke="#ff5c35" stroke-width="5" stroke-linecap="round" stroke-dasharray="70.7 23.55" transform="rotate(-45 32 32)"></circle>
    <path d="M26.3 16.5 24.9 24.9 17.9 17.9Z" fill="#ff5c35" stroke="#ff5c35" stroke-width="2" stroke-linejoin="round"></path>
    <path d="M25 33l5 5 9-11" fill="none" stroke="#f2eee5" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="cf-brand-word">change<b>loop</b></span>
</a>

<style>
  .cf-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: 14px;
    text-decoration: none;
    white-space: nowrap;
  }

  .cf-brand-mark {
    width: 30px;
    height: 30px;
    flex: none;
  }

  .cf-brand-word b {
    font-weight: 700;
  }

  /* The wordmark is the smallest thing in the header; drop it below the mark
     only when there is genuinely no room, rather than letting it wrap. */
  @media (max-width: 30rem) {
    .cf-brand-word {
      display: none;
    }
  }
</style>
