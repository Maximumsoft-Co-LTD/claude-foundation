# claude-foundation dashboard — server environment.
# Copy to .env for local runs (the .env file itself is git-ignored & secret-guarded).

# REQUIRED. The shared key every agent must present on heartbeat, and (by
# default) the key needed to view the dashboard. Use a long random string:
#   openssl rand -hex 24
SHARED_KEY=change-me-to-a-long-random-string

# OPTIONAL. Separate key for viewing the dashboard / calling GET /api/online.
# Defaults to SHARED_KEY when unset. Set this if viewers should not hold the
# same key the agents use to report in.
# VIEW_KEY=

# OPTIONAL. How long since the last heartbeat an agent still counts as "online"
# (milliseconds). Default 30000 (30s). Keep it ~2x the client --interval.
# ONLINE_TTL_MS=30000

# OPTIONAL. Port to listen on for LOCAL runs. Chosen to avoid the common dev
# ports (3000/5173/8000/8080/8888/9000). Railway sets PORT automatically in prod.
# PORT=8473

# OPTIONAL. SQLite file for persistence (presence survives restarts, heartbeat
# log, run/usage history). Defaults to $RAILWAY_VOLUME_MOUNT_PATH/dashboard.db
# when a Railway volume is attached, else ./data/dashboard.db (ephemeral on
# Railway without a volume). Needs Node >= 24 (node:sqlite); on older Node the
# server runs in-memory only, as before.
# DB_PATH=./data/dashboard.db

# OPTIONAL. Days of heartbeat log to keep before pruning. Default 30.
# HEARTBEAT_LOG_DAYS=30
