{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mutation-baseline-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "generatedAt", "tool", "scope", "counts", "score"],
  "properties": {
    "protocol": { "const": "foundation-mutation-baseline-v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "tool": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["killed", "timeout", "survived", "noCoverage"],
      "properties": {
        "killed": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "integer", "minimum": 0 },
        "survived": { "type": "integer", "minimum": 0 },
        "noCoverage": { "type": "integer", "minimum": 0 }
      }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
