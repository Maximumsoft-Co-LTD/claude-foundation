{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-surfaces-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "surfaces"],
  "properties": {
    "version": { "const": 1 },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "testCommand", "controls", "blocking"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "testCommand": { "type": "string", "minLength": 1 },
          "controls": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "blocking": { "type": "boolean" }
        }
      }
    }
  }
}
