{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-foundation.dev/schemas/openspec-native-scorecard-v1.json",
  "title": "Change Loop OpenSpec-native benchmark scorecard",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "scenario", "repeat", "runId", "provenance", "outcome", "timing", "usage", "operations", "quality", "evidenceReuse"],
  "properties": {
    "protocol": { "const": "foundation-openspec-native-scorecard-v1" },
    "scenario": { "$ref": "#/$defs/nonEmptyString" },
    "arm": { "enum": ["change-loop", "baseline"] },
    "repeat": { "type": "integer", "minimum": 1 },
    "runId": { "$ref": "#/$defs/nonEmptyString" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "host", "requestedModel", "actualModel", "configDigest", "startedAt", "finishedAt"],
      "properties": {
        "commit": { "$ref": "#/$defs/nullableString" },
        "dirty": { "type": ["boolean", "null"] },
        "host": { "$ref": "#/$defs/nullableString" },
        "requestedModel": { "$ref": "#/$defs/nullableString" },
        "actualModel": { "$ref": "#/$defs/nullableString" },
        "configDigest": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }] },
        "startedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "finishedAt": { "$ref": "#/$defs/nullableTimestamp" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "complete", "failureClass", "changeId", "workflowStatus", "pendingTasks", "requiredEvidencePassed", "proofStatus", "landStatus"],
      "properties": {
        "status": { "enum": ["completed", "blocked", "needs-user-decision", "incomplete", "failed", "timeout", "cancelled", "error"] },
        "complete": { "type": "boolean" },
        "failureClass": { "$ref": "#/$defs/nullableString" },
        "changeId": { "$ref": "#/$defs/nullableString" },
        "workflowStatus": { "$ref": "#/$defs/nullableString" },
        "pendingTasks": { "$ref": "#/$defs/nullableCount" },
        "requiredEvidencePassed": { "type": ["boolean", "null"] },
        "proofStatus": { "$ref": "#/$defs/nullableString" },
        "landStatus": { "$ref": "#/$defs/nullableString" },
        "decisionProvider": { "$ref": "#/$defs/nullableString" },
        "decisionKind": { "$ref": "#/$defs/nullableString" },
        "decisionDetectionSource": { "$ref": "#/$defs/nullableString" },
        "decisionFirstSeenWallMs": { "$ref": "#/$defs/nullableNumber" },
        "requestsAtDecision": { "$ref": "#/$defs/nullableCount" },
        "requestsAfterDecision": { "$ref": "#/$defs/nullableCount" },
        "suppressedDuplicateDecisions": { "$ref": "#/$defs/nullableCount" },
        "decisionFingerprint": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          ]
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wallMs", "wallMeasurement", "wallSource", "modelActiveMs", "harnessActiveMs", "providerMs", "externalExecutionMs", "humanWaitMs", "externalWaitMs", "unattributedWaitMs", "hostEnvelopeDurationMs"],
      "properties": {
        "wallMs": { "$ref": "#/$defs/nullableNumber" },
        "wallMeasurement": { "$ref": "#/$defs/measurement" },
        "wallSource": { "$ref": "#/$defs/nullableString" },
        "modelActiveMs": { "$ref": "#/$defs/nullableNumber" },
        "harnessActiveMs": { "$ref": "#/$defs/nullableNumber" },
        "providerMs": { "$ref": "#/$defs/nullableNumber" },
        "externalExecutionMs": { "$ref": "#/$defs/nullableNumber" },
        "humanWaitMs": { "$ref": "#/$defs/nullableNumber" },
        "externalWaitMs": { "$ref": "#/$defs/nullableNumber" },
        "unattributedWaitMs": { "$ref": "#/$defs/nullableNumber" },
        "hostEnvelopeDurationMs": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "classification", "costUsd", "costMeasurement", "costSource", "modelRequests", "inputTokens", "outputTokens", "cacheCreationTokens", "cacheReadTokens"],
      "properties": {
        "measurement": { "$ref": "#/$defs/measurement" },
        "classification": { "$ref": "#/$defs/nullableString" },
        "costUsd": { "$ref": "#/$defs/nullableNumber" },
        "costMeasurement": { "$ref": "#/$defs/measurement" },
        "costSource": { "$ref": "#/$defs/nullableString" },
        "modelRequests": { "$ref": "#/$defs/nullableCount" },
        "modelRequestsMeasurement": { "$ref": "#/$defs/measurement" },
        "observedModelRequests": { "$ref": "#/$defs/nullableCount" },
        "hostReportedModelRequests": { "$ref": "#/$defs/nullableCount" },
        "capConsumedModelRequests": { "$ref": "#/$defs/nullableCount" },
        "postTerminalModelRequests": { "$ref": "#/$defs/nullableCount" },
        "inputTokens": { "$ref": "#/$defs/nullableNumber" },
        "outputTokens": { "$ref": "#/$defs/nullableNumber" },
        "cacheCreationTokens": { "$ref": "#/$defs/nullableNumber" },
        "cacheReadTokens": { "$ref": "#/$defs/nullableNumber" },
        "tokenSource": { "$ref": "#/$defs/nullableString" }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "total", "failed", "blocked", "byCommand", "duplicateCandidates", "duplicateMeasurement", "browserCalls", "taskMirrorOperations"],
      "properties": {
        "measurement": { "$ref": "#/$defs/measurement" },
        "total": { "$ref": "#/$defs/nullableCount" },
        "failed": { "$ref": "#/$defs/nullableCount" },
        "blocked": { "$ref": "#/$defs/nullableCount" },
        "byCommand": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "duplicateCandidates": { "$ref": "#/$defs/nullableCount" },
        "duplicateMeasurement": { "$ref": "#/$defs/measurement" },
        "browserCalls": { "$ref": "#/$defs/nullableCount" },
        "taskMirrorOperations": { "$ref": "#/$defs/nullableCount" },
        "hostToolCalls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["measurement", "total", "byTool", "byCategory"],
          "properties": {
            "measurement": { "$ref": "#/$defs/measurement" },
            "total": { "$ref": "#/$defs/nullableCount" },
            "byTool": { "type": ["object", "null"], "additionalProperties": { "type": "integer", "minimum": 0 } },
            "byCategory": {
              "type": "object",
              "additionalProperties": false,
              "required": ["harnessCli", "harnessDocReads", "stateReads", "harnessArtifactWrites", "productWrites", "testRuns", "other"],
              "properties": {
                "harnessCli": { "$ref": "#/$defs/nullableCount" },
                "harnessDocReads": { "$ref": "#/$defs/nullableCount" },
                "stateReads": { "$ref": "#/$defs/nullableCount" },
                "harnessArtifactWrites": { "$ref": "#/$defs/nullableCount" },
                "productWrites": { "$ref": "#/$defs/nullableCount" },
                "testRuns": { "$ref": "#/$defs/nullableCount" },
                "other": { "$ref": "#/$defs/nullableCount" }
              }
            }
          }
        }
      }
    },
    "friction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "hookBlocks", "permissionPrompts", "toolErrors", "advanceActions", "guardrail"],
      "properties": {
        "measurement": { "enum": ["measured", "unavailable"] },
        "hookBlocks": { "$ref": "#/$defs/nullableCount" },
        "permissionPrompts": { "$ref": "#/$defs/nullableCount" },
        "toolErrors": { "$ref": "#/$defs/nullableCount" },
        "advanceActions": { "type": ["object", "null"], "additionalProperties": { "type": "integer", "minimum": 0 } },
        "guardrail": { "type": ["object", "null"], "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "skillUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "skillToolCalls", "skillsLoaded", "skillFilesRead"],
      "properties": {
        "measurement": { "enum": ["measured", "unavailable"] },
        "reason": { "type": "string" },
        "skillToolCalls": { "$ref": "#/$defs/nullableCount" },
        "skillsLoaded": { "type": ["array", "null"], "items": { "type": "string" } },
        "skillFilesRead": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "functions", "mappedFunctions", "coverageMinimum", "coverageMean", "crapMaximum", "pass", "warn", "fail", "unmapped", "product", "tooling"],
      "properties": {
        "measurement": { "$ref": "#/$defs/measurement" },
        "functions": { "$ref": "#/$defs/nullableCount" },
        "mappedFunctions": { "$ref": "#/$defs/nullableCount" },
        "coverageMinimum": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 100 }] },
        "coverageMean": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 100 }] },
        "crapMaximum": { "$ref": "#/$defs/nullableNumber" },
        "pass": { "$ref": "#/$defs/nullableCount" },
        "warn": { "$ref": "#/$defs/nullableCount" },
        "fail": { "$ref": "#/$defs/nullableCount" },
        "unmapped": { "$ref": "#/$defs/nullableCount" },
        "product": { "$ref": "#/$defs/qualitySummary" },
        "tooling": { "$ref": "#/$defs/qualitySummary" }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configured", "measurement", "verdict", "score", "max", "results", "reason", "source"],
      "properties": {
        "configured": { "type": "boolean" },
        "measurement": { "$ref": "#/$defs/measurement" },
        "verdict": { "type": ["string", "null"], "enum": ["pass", "fail", null] },
        "score": { "$ref": "#/$defs/nullableCount" },
        "max": { "$ref": "#/$defs/nullableCount" },
        "results": { "type": "object", "additionalProperties": { "enum": ["pass", "fail"] } },
        "reason": { "$ref": "#/$defs/nullableString" },
        "source": { "$ref": "#/$defs/nullableString" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "strict", "phases", "interruptions", "landOrder", "repairs", "checks"],
      "properties": {
        "protocol": { "$ref": "#/$defs/nullableString" },
        "strict": { "type": "boolean" },
        "phases": { "type": "array", "items": { "type": "object" } },
        "interruptions": { "type": "array", "items": { "type": "object" } },
        "landOrder": { "type": "array", "items": { "type": "string" } },
        "repairs": { "type": "object" },
        "checks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "detail"],
            "properties": {
              "status": { "enum": ["pass", "fail", "unavailable"] },
              "detail": {}
            }
          }
        }
      }
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "reason", "path", "outlineSource", "missingSections", "duplicateSections", "words", "editRounds", "editRoundsMeasurement", "compileMs", "compileMeasurement", "compileSource"],
      "properties": {
        "measurement": { "$ref": "#/$defs/measurement" },
        "reason": { "$ref": "#/$defs/nullableString" },
        "path": { "$ref": "#/$defs/nullableString" },
        "outlineSource": { "$ref": "#/$defs/nullableString" },
        "missingSections": { "$ref": "#/$defs/packetSections" },
        "duplicateSections": { "$ref": "#/$defs/packetSections" },
        "words": {
          "type": "object",
          "additionalProperties": false,
          "required": ["proposal", "design", "tasks"],
          "properties": {
            "proposal": { "$ref": "#/$defs/nullableCount" },
            "design": { "$ref": "#/$defs/nullableCount" },
            "tasks": { "$ref": "#/$defs/nullableCount" }
          }
        },
        "editRounds": { "$ref": "#/$defs/nullableCount" },
        "editRoundsMeasurement": { "$ref": "#/$defs/measurement" },
        "compileMs": { "$ref": "#/$defs/nullableNumber" },
        "compileMeasurement": { "$ref": "#/$defs/measurement" },
        "compileSource": { "$ref": "#/$defs/nullableString" }
      }
    },
    "evidenceReuse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "byReason"],
      "properties": {
        "count": { "$ref": "#/$defs/nullableCount" },
        "byReason": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "resumptions": { "$ref": "#/$defs/nullableCount" }
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "nullableString": { "type": ["string", "null"] },
    "nullableTimestamp": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
    "nullableNumber": { "type": ["number", "null"], "minimum": 0 },
    "nullableCount": { "type": ["integer", "null"], "minimum": 0 },
    "measurement": { "enum": ["measured", "partial", "unavailable"] },
    "packetSections": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "sections"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "sections": { "type": "array", "items": { "type": "object" } }
          }
        }
      ]
    },
    "qualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement", "functions", "mappedFunctions", "coverageMinimum", "coverageMean", "crapMaximum", "pass", "warn", "fail", "unmapped"],
      "properties": {
        "measurement": { "$ref": "#/$defs/measurement" },
        "functions": { "$ref": "#/$defs/nullableCount" },
        "mappedFunctions": { "$ref": "#/$defs/nullableCount" },
        "coverageMinimum": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 100 }] },
        "coverageMean": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0, "maximum": 100 }] },
        "crapMaximum": { "$ref": "#/$defs/nullableNumber" },
        "pass": { "$ref": "#/$defs/nullableCount" },
        "warn": { "$ref": "#/$defs/nullableCount" },
        "fail": { "$ref": "#/$defs/nullableCount" },
        "unmapped": { "$ref": "#/$defs/nullableCount" }
      }
    }
  }
}
