# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# Local environment and secrets (keep shareable templates)
.env
.env.*
!.env.example
!**/.env.example

# Logs, process files, and temporary work
*.log
*.pid
*.pid.lock
*.seed
*.tmp
*.temp
/tmp/
/.tmp-profile-bin/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node.js dependencies, build output, and test artifacts
**/node_modules/
**/test-results/
**/coverage/
**/playwright-report/
**/.nyc_output/
**/.cache/
/.stryker-tmp-dashboard/
/.stryker-tmp-runtime/
/.stryker-tmp-examples/
/.stryker-tmp-website/
/reports/mutation/
/.foundation/quality-history/
/.foundation/quality/

# Rust build output
/target/

# Python caches and virtual environments (skill scripts live under
# .claude/skills/*/scripts/)
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local agent/tool state
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.hyperresearch/
/.serena/

# SQLite runtime artifacts
/.changeloop/*.db
/.changeloop/*.db-shm
/.changeloop/*.db-wal
dashboard/data/*.db
dashboard/data/*.db-shm
dashboard/data/*.db-wal

# Root documentation is an allow-list; website/docs is a separate tree.
/docs/*
!/docs/roadmap.md
!/docs/threat-model.md
!/docs/migration-and-install-paths.md
!/docs/provider-replay-corpus.md
!/docs/quality-and-performance-baselines.md
!/docs/onboarding-and-updates.md
!/docs/extensions.md
!/docs/roadmap-traceability.md
!/docs/stability-and-deprecation.md
!/docs/database-recovery.md
!/docs/independent-review.md
!/docs/consumer-quality.md
!/docs/consumer-quality.th.md
!/docs/reports/
!/docs/reports/*.md
!/docs/adr/
!/docs/adr/*.md

# Astro/Starlight docs site build output. Source lives in website/docs/src;
# `website/docs/dist` is regenerated by the Pages workflow on every deploy.
# (The `/docs/*` rules above are anchored to the repo root and do not apply here.)
website/docs/dist/
website/docs/.astro/
solar-system/

# Externally cloned scratch. It carries its own .git, so committing it would
# record a gitlink to a repository with no configured URL — broken for anyone
# who clones this one.
opencode/
changeloop-cli/

# Residue from running the sandbox-land contract suite against the repo root.
# The suite writes these fixture names into its own temp project; they must
# never be committed here.
/NOTES.md
/app.txt
/current-link
