{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changeloop.dev/schema/provider-replay/exchange-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["equivalenceGroup", "parser", "terminal", "exactEvents", "exactError", "invariants"],
  "properties": {
    "equivalenceGroup": { "type": "string", "minLength": 1 },
    "parser": { "enum": ["anthropic", "openai"] },
    "terminal": { "enum": ["completed", "length", "cancelled", "error"] },
    "exactEvents": { "type": "array", "items": { "type": "object" } },
    "exactError": { "type": ["string", "null"] },
    "invariants": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
  }
}
